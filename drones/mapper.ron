// Mapper preset: 3D mapping. A 16-channel spinning lidar (360° × 60°) builds the
// 3D voxel map; IMU, barometer and GPS for the pose.
// Run: cargo run -p viewer -- --drone drones/mapper.ron
DroneSpec(
    name: "Mapper",
    airframe: (
        mass_kg: 1.4,
        max_speed: 6.0,      // m/s
        max_accel: 4.5,      // m/s²
        max_yaw_rate: 90.0,  // °/s
        radius: 0.3,         // m
        // Flight dynamics (optional, defaults shown for a small quadrotor):
        thrust_to_weight: 2.0,
        max_tilt_deg: 35.0,
        tilt_rate_deg: 300.0,
        attitude_tau_s: 0.08,
        motor_tau_s: 0.04,
        drag: 0.3,           // 1/s
        drag_quad: 0.02,     // 1/m
        // rotor_radius_m: Some(0.12), // default: 0.4 × radius
        // Battery (none: endless energy at full voltage). 4S 2200 mAh:
        // battery: Some((capacity_wh: 32.0, v_full: 16.8, v_empty: 13.2, r_internal: 0.04)),
    ),
    camera: (
        fov_deg: 90.0,
        pitch_deg: -10.0,
    ),
    sensors: [
        (
            kind: Lidar3D(
                channels: 16, rays: 360, fov_up_deg: 20.0, fov_down_deg: -40.0,
                range: 25.0, noise_std: 0.02, dropout: 0.01,
            ),
            mount: (pos: (0.0, 0.15, 0.0)),
            rate_hz: 5.0,
        ),
        (
            kind: Sonar(cone_deg: 25.0, range: 5.0, noise_std: 0.02),
            mount: (pos: (0.0, 0.0, -0.15)),
            rate_hz: 20.0,
        ),
        (
            kind: Imu(accel_std: 0.02, accel_bias: 0.02, gyro_std_deg: 0.1, gyro_bias_deg: 0.1),
            rate_hz: 100.0,
        ),
        (
            kind: Baro(noise_std: 0.05, drift: 0.01),
            rate_hz: 25.0,
        ),
        (
            kind: Gps(noise_std: 0.5),
            rate_hz: 5.0,
        ),
    ],
)
